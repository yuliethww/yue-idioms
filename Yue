  if(!a||!b){m.err='Please fill in the '+NM[t].n+' and its meaning.';renderModal();return}
  const o=t==='vocab'?{t:a,m:b,p,x}:{t:a,m:b};if(s)o.s=s;if(im)o.im=im;
  l[t]=l[t]||[];if(m.i>=0)l[t][m.i]=o;else l[t].push(o);
  lsave(l);
  if(more&&m.i<0){m.d={a:'',b:'',p:'',x:'',im:'',s};m.err='';renderModal();renderMain();toast('Added ✓');return}
  S.modal=null;renderModal();renderMain();toast(m.i<0?'Added ✓':'Changes saved')};
 window.itemDel=(lid,t,i)=>ask('Delete this '+NM[t].n+' for every user?','Delete',()=>{const l=lesson(lid);l[t].splice(i,1);lsave(l);renderMain();toast('Deleted')});

 /* ----- create / rename / delete a subfolder (can be nested) ----- */
 window.secEdit=(lid,old,parent)=>{if(!ADM()){toast('Only the admin can edit lessons',1);return}const l=lesson(lid);
  S.modal={t:'lsec',lid,old:old||'',parent:old?par(old):(parent||''),name:old?last(old):'',img:old?((l.secImg||{})[old]||''):'',err:''};renderModal()};
 function secModal(){const m=S.modal;return `<div class="ov" onmousedown="if(event.target===this){S.modal=null;renderModal()}"><div class="md sm spc" role="dialog" aria-label="Subfolder">${head(m.old?'Rename subfolder':'New subfolder')}
  ${m.parent?`<p class="pr" style="margin:6px 0 0">Inside: <b>${esc(lab(m.parent))}</b></p>`:''}
  <label>Name</label><input id="sec_n" value="${esc(m.name)}" autofocus autocomplete="off" placeholder="e.g. Greetings, Family, Food" onkeydown="if(event.key==='Enter')secSave()"><label>Photo <span style="font-weight:400">(optional)</span></label>${phRow(m.img,'secPick','secClr',1)}<input type="file" id="sec_f" accept="image/*" hidden onchange="secImg(this)">${m.err?`<div class="err">${m.err}</div>`:''}
  <div class="row end" style="margin-top:22px"><button class="gh" onclick="S.modal=null;renderModal()">Cancel</button><button class="pri" onclick="secSave()">Save</button></div></div></div>`}
 window.secPick=()=>{S.modal.name=$('#sec_n').value;$('#sec_f').click()};
 window.secClr=()=>{S.modal.name=$('#sec_n').value;S.modal.img='';renderModal()};
 window.secImg=async inp=>{const f=inp.files&&inp.files[0];inp.value='';if(!f)return;S.modal.name=$('#sec_n').value;try{S.modal.img=await imgSmall(f,220,'image/jpeg',.8);renderModal()}catch(e){toast(e.message||'Could not read image',1)}};
 window.secSave=()=>{const m=S.modal,l=lesson(m.lid),n=$('#sec_n').value.trim().replace(/\//g,'-');m.name=n;
  if(!n){m.err='Enter a name';renderModal();return}
  const np=m.parent?m.parent+'/'+n:n,all=secsOf(l);
  if(all.some(s=>s.toLowerCase()===np.toLowerCase()&&s!==m.old)){m.err='That subfolder already exists here';renderModal();return}
  l.secs=all;l.secImg=l.secImg||{};
  if(m.old){const re=p=>p===m.old?np:p.startsWith(m.old+'/')?np+p.slice(m.old.length):p;
   l.secs=l.secs.map(re);[...(l.vocab||[]),...(l.expr||[])].forEach(v=>{if(v.s)v.s=re(v.s)});
   const ni={};Object.keys(l.secImg).forEach(k=>{ni[re(k)]=l.secImg[k]});l.secImg=ni;
   if(S.sec&&(S.sec===m.old||S.sec.startsWith(m.old+'/')))S.sec=re(S.sec)}
  else{l.secs.push(np);S.sec=np}
  if(m.img)l.secImg[np]=m.img;else delete l.secImg[np];
  lsave(l);S.modal=null;renderModal();renderMain();scrollTo(0,0);toast(m.old?'Subfolder renamed':'Subfolder created')};
 window.secDel=lid=>{const s=S.sec,p=par(s);ask(`Delete the subfolder “${esc(lab(s))}” and any subfolders inside it? Its items stay in the lesson${p?', moved to “'+esc(lab(p))+'”':', without a subfolder'}.`,'Delete',()=>{const l=lesson(lid);
  l.secs=secsOf(l).filter(x=>x!==s&&!x.startsWith(s+'/'));
  [...(l.vocab||[]),...(l.expr||[])].forEach(v=>{if(v.s&&under(v,s)){if(p)v.s=p;else delete v.s}});
  Object.keys(l.secImg||{}).forEach(k=>{if(k===s||k.startsWith(s+'/'))delete l.secImg[k]});
  S.sec=p||null;lsave(l);renderMain();toast('Subfolder deleted')})};

