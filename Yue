/* ===== v12: practice by subfolder ===== */
(function(){
 const par=p=>p.includes('/')?p.slice(0,p.lastIndexOf('/')):'';
 const lab=p=>p.split('/').join(' › ');
 const last=p=>p.slice(p.lastIndexOf('/')+1);
 const under=(v,p)=>(v.s||'')===p||(v.s||'').startsWith(p+'/');
 const secsOf=l=>{const s=[];const add=p=>{if(!p)return;add(par(p));if(!s.includes(p))s.push(p)};(l.secs||[]).forEach(add);(l.vocab||[]).forEach(v=>add(v.s||''));return s};
 const sel=(l,k)=>k==='all'?(l.vocab||[]):k==='o'?(l.vocab||[]).filter(v=>!v.s):(l.vocab||[]).filter(v=>under(v,k));
 const build=(l,k)=>{
  if(k==='ex')return(l.quiz||[]).map(q=>{const o=shuf(q.opts);return{q:q.q,o,ok:o.indexOf(q.opts[0])}});
  const V=l.vocab||[],pool=[...new Set(V.map(v=>v.m))];
  return shuf(sel(l,k)).map(v=>{const wrong=shuf(pool.filter(m=>m!==v.m)).slice(0,3),o=shuf([v.m,...wrong]);
   return{q:`What does “${v.t}” mean?`,o,ok:o.indexOf(v.m),vi:V.indexOf(v),im:v.im||''}})};
 window.pracStart=k=>{const l=lesson(S.fid),qs=build(l,k);
  if(!qs.length||(k!=='ex'&&qs[0].o.length<2)){toast('Add at least 2 different words first',1);return}
  S.pq={lid:l.id,k,i:0,right:0,pick:null,qs};renderMain();scrollTo(0,0)};
 pracView=function(l){
  const V=l.vocab||[],has=V.length>=2,ex=(l.quiz||[]).length;
  if(!S.pq||S.pq.lid!==l.id){
   const cnt=n=>`${n} ${n===1?'word':'words'}`,item=(k,ic_,t,sub,n)=>`<button class="lrow" data-k="${esc(k)}" ${n?'':'disabled style="opacity:.5"'} onclick="pracStart(this.dataset.k)"><span class="lic">${ic_}</span><span class="lt"><b>${esc(t)}</b><small>${sub}</small></span><span class="pr">›</span></button>`;
   if(!has&&!ex)return `<div class="pbox" style="text-align:center;padding:22px 14px">Add at least 2 words to this lesson to start practicing.</div>`;
   const secs=secsOf(l),un=V.filter(v=>!v.s).length;
   return `<h3 style="font-size:1.5rem;margin:6px 0 4px">What do you want to practice?</h3><p class="pr" style="margin:0 0 14px">Choose a subfolder, or practice everything.</p><div class="lrows">`
    +(has?item('all','🌸','All words',cnt(V.length),V.length):'')
    +secs.map((s,j)=>{const n=sel(l,s).length;return item(s,sIc(l,s,j),par(s)?lab(s):last(s),cnt(n),n)}).join('')
    +(secs.length&&un?item('o','🍃','Other',cnt(un)+' without a subfolder',un):'')
    +(ex?item('ex','✏️','Exercises',`${ex} ${ex===1?'question':'questions'}`,ex):'')+`</div>`}
  const p=S.pq,back=`<button class="gh wide" onclick="S.pq=null;renderMain();scrollTo(0,0)">Choose another folder</button>`;
  if(p.i>=p.qs.length)return `<div class="panel" style="text-align:center"><div class="big">${p.right}/${p.qs.length}</div><p class="pr">correct answers 🌸</p><button class="pri wide" onclick="pracStart('${esc(p.k).replace(/'/g,"\\'")}')">Try again</button>${back}<button class="gh wide" onclick="go('learn')">Back to lessons</button></div>`;
  const q=p.qs[p.i],s=p.pick;
  return `<div class="pmeta"><span class="pr">${p.i+1}/${p.qs.length}</span><div class="bar"><i style="width:${Math.round((p.i+(s!=null?1:0))/p.qs.length*100)}%"></i></div></div>
  <p class="pq">${esc(q.q)}${q.vi!=null?` <button class="ib" aria-label="Play audio" onclick="say(${q.vi},'${l.id}')">${ic('sound')}</button>`:''}</p>${q.im?`<img class="wim" src="${q.im}" alt="" style="margin:0 0 12px">`:''}
  <div class="opts">${q.o.map((x,i)=>`<button class="opt ${s==null?'':i===q.ok?'good':i===s?'bad':''}" ${s!=null?'disabled':''} onclick="pracPick(${i})">${esc(x)}</button>`).join('')}</div>
  ${s!=null?`<div class="fb ${s===q.ok?'':'n'}"><b>${s===q.ok?'Correct!':'Not quite'}</b><div>The correct answer is ${esc(q.o[q.ok])}.</div></div><button class="pri wide" onclick="pracNext()">${p.i+1<p.qs.length?'Next question':'Finish'} →</button>`:''}`};
})();

