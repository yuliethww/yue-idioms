<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Yue Idioms</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;700&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #DCEAF2;
  --card: #FFFFFF;
  --ink: #315B56;
  --soft: #B8CEC1;
  --sage: #D5E7DC;
  --sage-d: #315B56;
  --sage-l: #EDF5F8;
  --line: #D3E4D9;
  --inp: #FFFFFF;
  --onpri: #FFFFFF;
  --shadow: 0 3px 12px rgba(47, 122, 82, .12);
  box-sizing: border-box;
  padding-top: env(safe-area-inset-top, 0px);
}

* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--ink); font: 400 15px/1.45 Nunito, system-ui, sans-serif; transition: background .3s, color .3s; }
h1, h2, h3 { font-family: Fraunces, Georgia, serif; margin: 0; }
h1 { font-size: 1.8rem; }
button { font: inherit; cursor: pointer; border: 0; border-radius: 12px; padding: 9px 14px; background: var(--sage-l); color: var(--ink); font-weight: 700; display: inline-flex; gap: 7px; align-items: center; justify-content: center; transition: transform .18s, filter .18s, background .25s, color .25s, box-shadow .25s; }
button:hover { filter: brightness(.96); transform: translateY(-1px); }
button:active { transform: scale(.97); }
#side { background: var(--card); padding: 20px 14px; position: sticky; top: 0; height: 100vh; overflow: auto; display: flex; flex-direction: column; gap: 4px; }
main { padding: 22px; max-width: 980px; }
.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 14px; }
.lc { background: var(--card); border-radius: 18px; box-shadow: var(--shadow); border-top: 7px solid var(--sage); padding: 16px; cursor: pointer; position: relative; transition: transform .25s, box-shadow .25s; }
.lc:hover { transform: translateY(-4px); box-shadow: 0 8px 20px rgba(47, 122, 82, .2); }
</style>
</head>
<body>
<div class="shell"><aside id="side">
<button class="nv on" onclick="go('home')">Home</button>
  <button class="nv" onclick="go('learn')">Learn</button>
  <button class="nv" onclick="go('cards')">Review</button>
  <button class="nv" onclick="go('profile')">Profile</button>
</aside>
<div class="col">
<header class="top" id="top">
<h1>Yue Idioms</h1>
</header>
<main id="main">
<div class="grid">
<div class="lc">Spanish</div>
<div class="lc">English</div>
<div class="lc">French</div>
</div>
</main></div></div>
<nav id="bnav"></nav>
</body>
</html>
